    <release version="2.5.2" date="2026-10-31"/>
    <release version="2.5.1" date="2026-10-31"/>
    <release version="2.5.0" date="2026-10-31"/>
    <release version="2.2.0" date="2026-10-27"/>
    <release version="2.1.0" date="2026-10-26"/>
    <release version="2.0.0" date="2026-10-25"/>
    <release version="1.4.0" date="2026-10-25"/>
    <release version="1.3.0" date="2026-10-25">
      <description>
        <p>Any color with an eyedropper, and text recognition.</p>
      </description>
    </release>
  </releases>
</component>
