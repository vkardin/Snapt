{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Snapt",
  "description": "__MSG_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "homepage_url": "https://vkardin.github.io/snapt/",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "downloads", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
